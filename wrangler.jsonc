{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marchone",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "marchone.officialgl.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // IDs are omitted on purpose: wrangler auto-provisions these on first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "marchone-db", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CACHE" }],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "marchone-assets" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 3 * * *", "*/5 * * * *"] }
}
